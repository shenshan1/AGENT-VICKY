import streamlit as st

# --- PAGE CONFIG ---
st.set_page_config(
    page_title="🎙️ VICKY – Vocal Intelligence Coach",
    page_icon="🎤",
    layout="centered"
)

# --- HEADER ---
st.title("🎙️ Meet VICKY – Your Vocal Intelligence Coach")
st.subheader("Also known as VIC")

st.markdown("""
Welcome! I'm **VICKY**, your AI-powered vocal coach.  
I'm here to help you warm up, refine your technique, and track your progress.
""")

# --- VOCAL GOAL INPUT ---
st.markdown("### ✍️ What's your vocal goal today?")
user_goal = st.text_input("Enter your focus (e.g. 'Improve pitch', 'Better breath control')")

if user_goal:
    st.success(f"Goal saved: {user_goal}")

# --- AUDIO UPLOAD ---
st.markdown("### 🎧 Upload Your Vocal Sample")
audio_file = st.file_uploader("Upload an audio file (MP3 or WAV)", type=["mp3", "wav"])

if audio_file:
    st.audio(audio_file, format='audio/wav')
    st.success("Vocal sample uploaded successfully!")

# --- CHAT INTERFACE ---
st.markdown("### 💬 Chat with VICKY")

# Initialize chat history
if "chat_history" not in st.session_state:
    st.session_state.chat_history = []

# User input
user_input = st.text_input("Ask me a vocal question or describe an issue you're facing:")

if user_input:
    st.session_state.chat_history.append({"role": "user", "content": user_input})

    # Simulated AI reply
    simulated_replies = {
        "pitch": "Let's work on pitch accuracy! Start with a slow 5-tone scale (Do-Re-Mi-Fa-So) and hold each note.",
        "breath": "Try a 'hiss' exercise: Inhale deeply, then exhale with a steady hiss for as long as you can.",
        "tone": "Focus on relaxed vocal cords and good posture. Sing an 'ahh' sound with minimal tension.",
        "confidence": "Confidence comes from repetition and breath control. Sing in front of a mirror to build poise.",
    }

    lower_input = user_input.lower()
    response = next((v for k, v in simulated_replies.items() if k in lower_input), "That's a great question! Keep your posture tall and your breath steady. Want to try a warmup?")

    st.session_state.chat_history.append({"role": "assistant", "content": response})

# Display chat history
for chat in st.session_state.chat_history:
    speaker = "You" if chat["role"] == "user" else "VICKY"
    st.markdown(f"**{speaker}:** {chat['content']}")

# --- FOOTER ---
st.markdown("---")
st.caption("VICKY is part of the Nrth Eydn Ltd. creative development platform. Streamlit-only version.")


